# ================================================================
# Nebula Terminal Custom — Variables d'environnement requises
#
# Copie ce fichier vers `.env` et remplis les valeurs, OU exporte
# ces variables dans ton shell. Le projet lira ces variables.
# ATTENTION : ne JAMAIS committer le fichier .env (du .gitignore).
# ================================================================

# --- Shodan API (module NOSINT, étape 3) ---
# https://account.shodan.io/
SHODAN_API_KEY=

# --- Nebula AI : mode online (OpenAI) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Nebula AI : TTS ElevenLabs (optionnel) ---
# https://elevenlabs.io/
ELEVENLABS_API_KEY=

# --- Proxy Tor (module NOSINT, étape 2 — darkweb) ---
TOR_PROXY_HOST=127.0.0.1
TOR_PROXY_PORT=9050