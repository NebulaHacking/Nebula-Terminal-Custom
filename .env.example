# ================================================================
# Nebula Terminal Custom — Variables d'environnement
#
# Copie ce fichier vers `.env` et remplis seulement ce dont tu as besoin.
# `ia key <fournisseur>` remplit aussi .env pour toi (saisie masquée).
# ATTENTION : ne JAMAIS committer le fichier .env (il est dans .gitignore).
# ================================================================

# --- Nebula IA (commande ia) : une seule clé suffit ---
# Claude      https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ChatGPT     https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Gemini      https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Mistral     https://console.mistral.ai/
MISTRAL_API_KEY=
# Groq        https://console.groq.com/keys
GROQ_API_KEY=
# DeepSeek    https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# OpenRouter  https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Ollama (local, sans clé) : adresse si ce n'est pas http://localhost:11434
OLLAMA_HOST=

# --- Shodan API (module NOSINT, étape 3) ---
# https://account.shodan.io/
SHODAN_API_KEY=

# --- Proxy Tor (module NOSINT, étape 2 — darkweb) ---
TOR_PROXY_HOST=127.0.0.1
TOR_PROXY_PORT=9050
